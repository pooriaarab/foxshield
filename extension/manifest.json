{
  "manifest_version": 3,
  "name": "foxshield — find hidden prompt injection",
  "version": "0.1.2",
  "description": "Find hidden text and prompt injection in a web page before an agent reads it.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxshield@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "scripting",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Scan this page with foxshield",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_popup": "popup.html"
  }
}
